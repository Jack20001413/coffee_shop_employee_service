[flake8]
; This adheres to Black formatting
max-line-length = 120
; Prevents Flake8 to traverse these directories
exclude = 
    .git,
    __pycache__
extend-ignore =
    ; Whitespaces before ":"
    E203
per-file-ignores = 
    ; imported but unused
    __init__.py: F401,
    src/modules/shared/repository/context.py: F401,
    src/modules/workplace/repository/context.py: F401,
    src/modules/shared/repository/migrations/env.py: F401

